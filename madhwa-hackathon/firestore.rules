
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // HELPER FUNCTIONS
    // =========================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function userExists() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function userRole() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.role;
    }

    function hasRole(role) {
      return userExists() && userRole() == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isSuperAdmin() {
      return hasRole('super_admin');
    }

    function isAssignableRole(role) {
      return role in ['employee', 'admin'];
    }

    // New meal preferences must be booleans.
    function validNewMealPreferences(data) {
      return data.breakfast is bool
        && data.lunch is bool
        && data.snacks is bool
        && data.dinner is bool;
    }

    // Historical arrays may remain unchanged during an update.
    // Employees cannot create new arrays or modify existing arrays.
    function validUpdatedMealValue(field) {
      return request.resource.data[field] is bool
        || (
          field in resource.data
          && resource.data[field] is list
          && request.resource.data[field] == resource.data[field]
        );
    }

    function validUpdatedMealPreferences() {
      return validUpdatedMealValue('breakfast')
        && validUpdatedMealValue('lunch')
        && validUpdatedMealValue('snacks')
        && validUpdatedMealValue('dinner');
    }

    function validMealSelectionMetadata(userId, date) {
      let data = request.resource.data;

      return data.keys().hasAll([
          'breakfast',
          'lunch',
          'snacks',
          'dinner'
        ])
        && (!('employeeId' in data)
            || data.employeeId == userId)
        && (!('userId' in data)
            || data.userId == userId)
        && (!('date' in data)
            || data.date == date)
        && (!('email' in data)
            || data.email is string)
        && (!('status' in data)
            || data.status is string)
        && (!('timestamp' in data)
            || data.timestamp is string
            || data.timestamp is timestamp)
        && (!('updatedAt' in data)
            || data.updatedAt is string
            || data.updatedAt is timestamp)
        && (!('modified' in data)
            || data.modified is bool);
    }

    // Sunday is a permanent weekly holiday.
    function isNotSunday(date) {
      let parts = date.split('-');
      return date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && timestamp.date(int(parts[0]), int(parts[1]), int(parts[2])).dayOfWeek() != 7;
    }


    // =========================================================
    // USERS
    // =========================================================

    match /users/{userId} {

      allow read: if isSignedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
          || isSuperAdmin()
        );

      allow create: if isSuperAdmin()
        && isAssignableRole(request.resource.data.role);

      allow update: if isSuperAdmin()
        && isAssignableRole(resource.data.role)
        && isAssignableRole(request.resource.data.role);

      allow delete: if isSuperAdmin()
        && isAssignableRole(resource.data.role);
    }


    // =========================================================
    // MENUS — ADMIN CONTROLLED
    // =========================================================

    match /menus/{date} {

      allow read: if isSignedIn();

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // DAILY STAPLES — ADMIN CONTROLLED
    // =========================================================

    match /dailyStaples/{documentId} {

      allow read: if isSignedIn();

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // DEFAULT MENU — ADMIN CONTROLLED
    // =========================================================

    match /defaultMenu/{documentId} {

      allow read: if isSignedIn();

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // SETTINGS
    // =========================================================

    match /settings/{settingId} {

      allow read: if isSignedIn();

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // MEAL SELECTIONS
    // =========================================================

    match /mealSelections/{date}/users/{userId} {

      // Employees can read their own selections.
      // Admins can read all employee selections.

      allow read: if isSignedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
          || isSuperAdmin()
        );

      // New documents must use boolean meal preferences.

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && isNotSunday(date)
        && validMealSelectionMetadata(userId, date)
        && validNewMealPreferences(request.resource.data);

      // Updates allow boolean preferences.
      // Historical arrays are allowed only when unchanged.

      allow update: if isSignedIn()
        && request.auth.uid == userId
        && isNotSunday(date)
        && validMealSelectionMetadata(userId, date)
        && validUpdatedMealPreferences();

      // Employees cannot delete meal-selection documents.

      allow delete: if false;
    }


    // =========================================================
    // WORKING MODES
    // =========================================================

    match /workingModes/{date}/users/{userId} {

      allow read: if isSignedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      allow create, update: if isSignedIn()
        && request.auth.uid == userId;

      allow delete: if false;
    }


    // =========================================================
    // REPORTS
    // =========================================================

    match /reports/{date} {

      allow read, create, update, delete: if isAdmin();
    }


    // =========================================================
    // ANNOUNCEMENTS
    // =========================================================

    match /announcements/{announcementId} {

      allow read: if isSignedIn();

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // DENY EVERYTHING ELSE
    // =========================================================

    match /{document=**} {

      allow read, write: if false;
    }
  }
}
